# Copy this file to .env and fill it in
MONGODB_URI=mongodb+srv://<user>:<password>@<cluster>.mongodb.net/boardready?retryWrites=true&w=majority
JWT_SECRET=put-a-long-random-string-here
# Optional: enables "Continue with Google" (see README for how to get one)
GOOGLE_CLIENT_ID=
# Optional: comma-separated emails that can open the Admin page (create these accounts yourself first)
ADMIN_EMAILS=
PORT=3000
